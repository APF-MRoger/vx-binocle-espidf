BO_ 272 base_slow_metrics: 8 interface_board
 SG_ lv_voltage_v : 16|8@1+ (0.1,0) [0|25.5] "V"  right_display,left_display
 SG_ fuel_level_pc : 8|8@1+ (0.5,0) [0|127.5] "pc"  right_display,left_display
 SG_ coolant_temp : 0|8@1+ (0.4,70) [70|172] "degC"  right_display,left_display

BO_ 256 base_fast_metrics: 8 interface_board
 SG_ speed_kph : 16|16@1+ (0.04,0) [0|2621.4] "kph"  right_display,left_display
 SG_ rpm : 0|16@1+ (0.14,0) [0|9174.9] ""  right_display,left_display



