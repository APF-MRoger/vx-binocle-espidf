 SG_ parking_brake_AL_TT : 4|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ over_temperature_TT : 16|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ alternator_AL_TT : 2|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ oil_pressure_AL_TT : 5|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ fuel_low_TT : 17|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ coolant_low_AL_TT : 12|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ brake_low_AL_TT : 3|1@1+ (1,0) [0|1] ""  right_display,left_display
