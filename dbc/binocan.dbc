BS_:

BU_: external_controller interface_board right_display left_display
VAL_TABLE_ Binary_ST 1 "ON" 0 "OFF" ;


BO_ 513 extra_chargecooling_metrics: 8 external_controller
 SG_ bitmask : 0|8@1+ (1,0) [0|255] ""  right_display,left_display
 SG_ charge_coolant_temp_out : 16|8@1+ (1,0) [0|255] "degC"  right_display,left_display
 SG_ charge_coolant_temp_in : 8|8@1+ (1,0) [0|255] "degC"  right_display,left_display

BO_ 257 base_telltales: 8 interface_board
 SG_ turn_indicators_TT : 11|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ parking_brake_TT : 10|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ over_temperature_TT : 9|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ lv_system_TT : 8|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ low_oil_pressure_TT : 7|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ low_fuel_TT : 6|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ low_coolant_TT : 5|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ low_brake_fluid_TT : 4|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ high_beams_TT : 3|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ CEL_TT : 2|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ airbag_TT : 1|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ abs_TT : 0|1@1+ (1,0) [0|1] ""  right_display,left_display

BO_ 512 extra_oil_metrics: 8 external_controller
 SG_ bitmask : 0|8@1+ (1,0) [0|255] ""  right_display,left_display
 SG_ oil_temperature : 16|8@1+ (1,0) [0|255] "degC"  right_display,left_display
 SG_ oil_pressure : 8|8@1+ (0.1,0) [0|25.5] "bar"  right_display,left_display

BO_ 272 base_slow_metrics: 8 interface_board
 SG_ lv_voltage : 16|8@1+ (0.1,0) [0|25.5] "V"  right_display,left_display
 SG_ fuel_level : 8|8@1+ (0.5,0) [0|127.5] "pc"  right_display,left_display
 SG_ coolant_temp : 0|8@1+ (0.4,70) [70|172] "degC"  right_display,left_display

BO_ 256 base_vehicle_metrics: 8 interface_board
 SG_ ignition_ST : 32|1@1+ (1,0) [0|1] ""  right_display,left_display
 SG_ speed : 16|16@1+ (0.04,0) [0|2621.4] "kph"  right_display,left_display
 SG_ rpm : 0|16@1+ (0.14,0) [0|9174.9] ""  right_display,left_display



